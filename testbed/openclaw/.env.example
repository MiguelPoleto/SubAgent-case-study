# Copie para .env; este arquivo local nunca deve ser versionado.
# Gere um valor aleatório, por exemplo: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# GID numérico do socket Docker que o Gateway usará para criar sandboxes.
# Em Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=

# A porta é publicada exclusivamente em 127.0.0.1 pelo compose.yaml.
OPENCLAW_GATEWAY_PORT=18789

# Mantenha um tag exato para reprodução. Atualize após testar uma nova versão.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.3

# Para Docker rootless, informe o socket do usuário, por exemplo:
# OPENCLAW_DOCKER_SOCKET=/run/user/1000/docker.sock
