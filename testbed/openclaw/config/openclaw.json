{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token"
    }
  },
  "agents": {
    "defaults": {
      "sandbox": {
        "mode": "all",
        "backend": "docker",
        "scope": "session",
        "workspaceAccess": "none",
        "workspaceRoot": "/home/node/.openclaw/sandboxes",
        "docker": {
          "image": "openclaw-testbed-sandbox:bookworm-slim",
          "containerPrefix": "openclaw-testbed-sbx-",
          "workdir": "/workspace",
          "readOnlyRoot": true,
          "tmpfs": ["/tmp", "/var/tmp", "/run"],
          "network": "none",
          "user": "1000:1000",
          "capDrop": ["ALL"],
          "pidsLimit": 128,
          "memory": "768m",
          "memorySwap": "768m",
          "cpus": 1,
          "ulimits": {
            "nofile": { "soft": 1024, "hard": 2048 },
            "nproc": 128
          }
        },
        "prune": {
          "idleHours": 8,
          "maxAgeDays": 2
        }
      }
    }
  },
  "tools": {
    "sandbox": {
      "tools": {
        "allow": ["exec", "process", "read", "write", "edit", "apply_patch"],
        "deny": ["browser", "canvas", "cron", "gateway", "nodes", "sessions_spawn"]
      }
    },
    "sessions": {
      "visibility": "tree"
    }
  }
}
